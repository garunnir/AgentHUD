<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentHud</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings.tsv" LogicalName="AgentHud.Strings.tsv" />
    <None Include="native\VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" Link="VirtualDesktopAccessor.dll" />
  </ItemGroup>
  <!-- 릴리스 워크플로가 -p:UpdateAsset=win-x64.zip 처럼 넘기면 자동 업데이트가 같은 배포 형태의 zip을 고름. 개발 빌드는 비어 있어 업데이트 비활성 -->
  <ItemGroup Condition="'$(UpdateAsset)' != ''">
    <AssemblyMetadata Include="UpdateAsset" Value="$(UpdateAsset)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentHud.Core\AgentHud.Core.csproj" />
  </ItemGroup>
</Project>
