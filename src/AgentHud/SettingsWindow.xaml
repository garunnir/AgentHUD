<Window x:Class="AgentHud.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="300" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
  <Border CornerRadius="14" Background="#EE14171D" BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="14">
    <StackPanel>
      <DockPanel MouseLeftButtonDown="Header_OnMouseLeftButtonDown" Background="Transparent">
        <Button DockPanel.Dock="Right" Content="×" Click="Close_OnClick" Foreground="#91A0B5" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip="닫기"/>
        <TextBlock Text="설정" Foreground="#91A0B5" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
      <CheckBox Margin="0,12,0,0" IsChecked="{Binding ShowWaitingSymbols, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="대기 상태를 기호로 표시 (? / !)"/>
      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Right" Text="분" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding CodexActiveMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
        <TextBlock Text="Codex 활성 유지 시간" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Text="Codex는 프로세스를 확인할 수 없어, 마지막 이벤트 후 이 시간 동안만 활성으로 봅니다. 질문 대기 중 사라진다면 늘리세요. (1–1440)" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</Window>
