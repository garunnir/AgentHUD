<Window x:Class="AgentHud.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgentHud" Width="300" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
  <Border CornerRadius="14" Background="#EE14171D" BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="14">
    <StackPanel>
      <DockPanel MouseLeftButtonDown="Header_OnMouseLeftButtonDown" Background="Transparent">
        <Button DockPanel.Dock="Right" Content="×" Click="Close_OnClick" Foreground="#91A0B5" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip="{local:Tr Common.Close}"/>
        <TextBlock Text="{local:Tr Settings.Title}" Foreground="#91A0B5" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="0,12,0,0">
        <ComboBox DockPanel.Dock="Right" Width="110" ItemsSource="{Binding Languages, Source={x:Static local:Loc.Instance}}" SelectedValuePath="Code" DisplayMemberPath="Name" SelectedValue="{Binding FallbackLanguage, Mode=TwoWay}" FontSize="12"/>
        <TextBlock Text="{local:Tr Settings.Language}" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Text="{Binding LanguageHint, Source={x:Static local:Loc.Instance}}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
      <CheckBox Margin="0,12,0,0" IsChecked="{Binding ShowWaitingSymbols, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.WaitingSymbols}"/>
      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Right" Text="{local:Tr Settings.Minutes}" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding CodexActiveMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
        <TextBlock Text="{local:Tr Settings.CodexActive}" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Text="{local:Tr Settings.CodexActiveHint}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
      <CheckBox Margin="0,14,0,0" IsChecked="{Binding CompleteSoundEnabled, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.CompleteSound}"/>
      <DockPanel Margin="0,4,0,0" IsEnabled="{Binding CompleteSoundEnabled}">
        <Button DockPanel.Dock="Right" Content="▶" Tag="Complete" Click="TestSound_OnClick" Margin="4,0,0,0" Padding="8,0" ToolTip="{local:Tr Settings.Preview}"/>
        <Button DockPanel.Dock="Right" Content="{local:Tr Settings.File}" Tag="Complete" Click="BrowseSound_OnClick" Margin="4,0,0,0" Padding="6,0" ToolTip="{Binding CompleteSoundFile}"/>
        <ComboBox ItemsSource="{x:Static local:SoundSetting.Options}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding CompleteSound, Mode=TwoWay}" FontSize="12"/>
      </DockPanel>
      <CheckBox Margin="0,10,0,0" IsChecked="{Binding AskSoundEnabled, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.AskSound}"/>
      <DockPanel Margin="0,4,0,0" IsEnabled="{Binding AskSoundEnabled}">
        <Button DockPanel.Dock="Right" Content="▶" Tag="Ask" Click="TestSound_OnClick" Margin="4,0,0,0" Padding="8,0" ToolTip="{local:Tr Settings.Preview}"/>
        <Button DockPanel.Dock="Right" Content="{local:Tr Settings.File}" Tag="Ask" Click="BrowseSound_OnClick" Margin="4,0,0,0" Padding="6,0" ToolTip="{Binding AskSoundFile}"/>
        <ComboBox ItemsSource="{x:Static local:SoundSetting.Options}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding AskSound, Mode=TwoWay}" FontSize="12"/>
      </DockPanel>
      <CheckBox Margin="0,12,0,0" IsChecked="{Binding NotifyLimitReset, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.NotifyLimitReset}"/>
      <CheckBox Margin="20,6,0,0" IsChecked="{Binding NotifyVisibleOnly, Mode=TwoWay}" IsEnabled="{Binding NotifyLimitReset}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.NotifyVisibleOnly}"/>
      <CheckBox Margin="0,8,0,0" IsChecked="{Binding AutoResume, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.AutoResume}"/>
      <TextBox Margin="0,6,0,0" Text="{Binding ResumePrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding AutoResume}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12" ToolTip="{local:Tr Settings.ResumePromptTip}"/>
      <TextBlock Margin="0,4,0,0" Text="{local:Tr Settings.AutoResumeHint}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
      <CheckBox Margin="0,14,0,0" IsChecked="{Binding ClaudeLimitLinked, Mode=TwoWay}" Foreground="#DCE3ED" FontSize="12" Content="{local:Tr Settings.ClaudeLink}"/>
      <TextBlock Margin="0,4,0,0" Text="{local:Tr Settings.ClaudeLinkHint}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Margin="0,14,0,0" Text="{local:Tr Settings.ClaudeApi}" Foreground="#DCE3ED" FontSize="12"/>
      <TextBlock Margin="0,6,0,0" Text="{local:Tr Settings.OrgId}" Foreground="#91A0B5" FontSize="11"/>
      <TextBox Margin="0,2,0,0" Text="{Binding ClaudeOrgId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
      <TextBlock Margin="0,6,0,0" Text="{local:Tr Settings.SessionKey}" Foreground="#91A0B5" FontSize="11"/>
      <DockPanel Margin="0,2,0,0">
        <Button DockPanel.Dock="Right" Content="{local:Tr Settings.Save}" Click="SaveKey_OnClick" Margin="6,0,0,0" Padding="8,2"/>
        <PasswordBox x:Name="KeyBox" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
      </DockPanel>
      <DockPanel Margin="0,4,0,0">
        <Button DockPanel.Dock="Right" Content="{local:Tr Settings.DeleteKey}" Click="DeleteKey_OnClick" Padding="6,0" FontSize="11"/>
        <TextBlock Text="{Binding ClaudeApiStatus}" Foreground="#AEB8C6" FontSize="11" TextWrapping="Wrap"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Text="{local:Tr Settings.ClaudeApiHint}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock Margin="0,14,0,0" Text="{local:Tr Settings.Budget}" Foreground="#DCE3ED" FontSize="12"/>
      <DockPanel Margin="0,6,0,0">
        <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding ClaudeBudget5h, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
        <TextBlock Text="{local:Tr Settings.Budget5h}" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="0,6,0,0">
        <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding ClaudeBudgetWeek, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" Background="#22FFFFFF" Foreground="#DCE3ED" CaretBrush="White" BorderThickness="0" Padding="4,2" FontSize="12"/>
        <TextBlock Text="{local:Tr Settings.BudgetWeek}" Foreground="#DCE3ED" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Margin="0,4,0,0" Text="{local:Tr Settings.BudgetHint}" Foreground="#91A0B5" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</Window>
