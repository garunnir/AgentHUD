<Window x:Class="AgentHud.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:AgentHud.Models" xmlns:local="clr-namespace:AgentHud" Title="Agent HUD" Width="280" Height="220" MinWidth="240" MinHeight="100" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Opacity" Value="1"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="Pulsing">
          <Trigger.EnterActions>
            <BeginStoryboard Name="Pulse">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Pulse"/></Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="StatusIndicator" TargetType="ContentControl">
      <Grid Background="Transparent" ToolTip="{Binding StatusTip}" AutomationProperties.Name="{Binding StatusTip}">
        <Ellipse x:Name="Dot" Width="11" Height="11" Style="{StaticResource StatusDot}" Fill="{Binding DisplayState, Converter={StaticResource StateBrush}}"/>
        <Path x:Name="Check" Visibility="Collapsed" Data="M 1,5 L 4,8 L 10,1" Width="10" Height="9" Stretch="Uniform" Stroke="{Binding DisplayState, Converter={StaticResource StateBrush}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="Attention" Visibility="Collapsed" Text="?" FontSize="14" FontWeight="Bold" Foreground="{Binding DisplayState, Converter={StaticResource StateBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.WaitingForInput}"/>
            <Condition Binding="{Binding DataContext.ShowWaitingSymbols, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Attention" Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.WaitingForApproval}"/>
            <Condition Binding="{Binding DataContext.ShowWaitingSymbols, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Attention" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Attention" Property="Text" Value="!"/>
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.Starting}">
          <Setter TargetName="Dot" Property="Tag" Value="Pulsing"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.Working}">
          <Setter TargetName="Dot" Property="Tag" Value="Pulsing"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.Thinking}">
          <Setter TargetName="Dot" Property="Tag" Value="Pulsing"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static m:AgentState.Completed}">
          <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
