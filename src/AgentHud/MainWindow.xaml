  </Window.Resources>
  <Border x:Name="Frame" CornerRadius="14" Background="#EE14171D" BorderBrush="#3AFFFFFF" BorderThickness="1" Padding="14">
    <Border.ContextMenu>
      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{Binding HiddenCount}" HeaderStringFormat="숨긴 세션 다시 표시 ({0})" Click="ResetHidden_OnClick">
          <MenuItem.Style>
            <Style TargetType="MenuItem">
              <Style.Triggers><DataTrigger Binding="{Binding HiddenCount}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
            </Style>
          </MenuItem.Style>
        </MenuItem>
        <Separator/>
        <MenuItem Header="설정..." Click="Settings_OnClick"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid>
    <Grid x:Name="FullView">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- 바깥 Border가 프레임 위·좌·우 가장자리까지 늘어나 상단바 전체를 드래그·더블클릭 영역으로 만듦 -->
      <Border Background="Transparent" Margin="-14,-14,-14,0" Padding="14,14,14,0" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
      <DockPanel>
        <TextBlock Text="AGENTS" Foreground="#91A0B5" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="×" Click="Close_OnClick" Foreground="#91A0B5" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip="Close"/>
        <Button DockPanel.Dock="Right" Content="–" Click="Minimize_OnClick" Foreground="#91A0B5" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip="최소화"/>
        <Button DockPanel.Dock="Right" Content="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="Memo_OnClick" Foreground="#91A0B5" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip="메모장"/>
        <TextBlock Text="{Binding ActiveCount}" Foreground="White" FontWeight="Bold" Margin="8,0,0,0"/>
      </DockPanel>
      </Border>
      <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="List_OnMouseDoubleClick">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,4"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type m:AgentSession}">
            <Grid Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="프로젝트 메모..." Click="ProjectMemo_OnClick"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="3" Text="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}" Foreground="#DCE3ED" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <ContentControl Width="12" Height="18" Focusable="False" Template="{StaticResource StatusIndicator}"/>
              <Viewbox Grid.Column="1" Width="16" Height="16" Margin="0,0,6,0" ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}">
                <Path Stretch="Uniform" Style="{StaticResource AgentIconStyle}"/>
              </Viewbox>
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Right" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#91A0B5" Margin="4,0,0,0" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonDown="MemoIcon_OnMouseLeftButtonDown" Cursor="Hand">
                  <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource ProjectMemo}">
                      <Binding Path="ProjectPath"/>
                      <Binding Path="DataContext.Memos" RelativeSource="{RelativeSource AncestorType=Window}"/>
                      <Binding Path="DataContext.MemoVersion" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                  </TextBlock.Visibility>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource ProjectMemo}" ConverterParameter="Text">
                      <Binding Path="ProjectPath"/>
                      <Binding Path="DataContext.Memos" RelativeSource="{RelativeSource AncestorType=Window}"/>
                      <Binding Path="DataContext.MemoVersion" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="{Binding ProjectName}" ToolTip="{Binding ProjectPath}" Foreground="#AEB8C6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid Grid.Column="4" Margin="8,0,0,0">
                <TextBlock x:Name="StateText" Text="{Binding DisplayState}" ToolTip="{Binding StatusTip}" Foreground="#AEB8C6" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="DismissButton" Content="×" Click="Dismiss_OnClick" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="HUD에서 숨기기" Focusable="False">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="6,0"><TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" Foreground="#91A0B5" FontSize="14"/></Border>
                      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/><Setter TargetName="Glyph" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="StateText" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="DismissButton" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- 사용량: 감지된 LLM별 5시간·주간 막대 -->
      <ItemsControl Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding UsageRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:UsageRow}">
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14" Margin="0,0,5,0" ToolTip="{Binding AgentName}"><Path Stretch="Uniform" Style="{StaticResource AgentIconStyle}"/></Viewbox>
                <TextBlock Text="{Binding Label}" Foreground="#91A0B5" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Column="1" Visibility="{Binding BarVisibility}" Margin="0,0,8,0" ToolTip="{Binding BarToolTip}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" Foreground="{Binding Fill}" Height="16" BorderThickness="0" Background="#2AFFFFFF">
                  <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                      <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                        <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid>
                      </Border>
                    </ControlTemplate>
                  </ProgressBar.Template>
                </ProgressBar>
                <!-- 권장 잔량 눈금: 막대 끝이 눈금보다 오른쪽이면 페이스보다 여유 있음 -->
                <Grid Visibility="{Binding PaceVisibility}" IsHitTestVisible="False">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding PaceLeft}"/><ColumnDefinition Width="{Binding PaceRight}"/></Grid.ColumnDefinitions>
                  <Rectangle Width="2" HorizontalAlignment="Right" Fill="White" Opacity="0.9" Margin="0,-1"/>
                </Grid>
                <TextBlock Text="{Binding BarText}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="#AEB8C6" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <!-- 최소화 모드: 세션별 상태 점만 가로로 나열. 드래그로 이동, 더블클릭으로 복원 -->
    <ItemsControl x:Name="MiniView" ItemsSource="{Binding Sessions}" Visibility="Collapsed" MinWidth="14" MinHeight="14" Background="Transparent" MouseLeftButtonDown="Mini_OnMouseLeftButtonDown">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type m:AgentSession}">
          <ContentControl Width="12" Height="18" Margin="2,0" Focusable="False" Template="{StaticResource StatusIndicator}" ToolTip="{Binding ProjectName}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>
  </Border>
</Window>


